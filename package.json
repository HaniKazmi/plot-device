{
  "name": "plot-device",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://plot.hani.fyi",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --cname plot.hani.fyi --no-history",
    "lint": "eslint .",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "format": "prettier --write .",
    "preview": "vite preview",
    "analyze": "source-map-explorer 'dist/assets/*.js' --no-border-checks"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@highcharts/react": "~5.3.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "fast-average-color": "^9.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/chrome": "^0.2.7",
    "@types/gapi": "^0.0.47",
    "@types/gapi.client": "^1.0.8",
    "@types/gapi.client.sheets": "^4.0.20201031",
    "@types/google.accounts": "~0.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.3.2",
    "source-map-explorer": "^2.5.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.10"
  }
}
