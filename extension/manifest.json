{
  "manifest_version": 3,
  "name": "Plot Device Uploader",
  "description": "Uploads game, show and movie artwork to the Plot Device buckets",
  "version": "2.0",
  "key": "",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-large.png"
  },
  "permissions": ["contextMenus", "identity", "storage", "clipboardWrite"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
